# PostgreSQL (dev bằng Docker, xem README)
DATABASE_URL=postgres://umaru:umaru@127.0.0.1:55432/umaru
# BẮT BUỘC đổi khi NODE_ENV=production (server từ chối chạy với secret dev)
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
PORT=4000
HOST=127.0.0.1
SNOWFLAKE_WORKER_ID=0

# Token
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Tệp đính kèm (G1: lưu trên đĩa cục bộ; đổi sang R2/S3 thì chỉ thay lớp storage)
# UPLOADS_DIR=.data/uploads
MAX_UPLOAD_BYTES=10485760

# Gateway (spec: docs/gateway-protocol.md)
HEARTBEAT_INTERVAL_MS=41250
SESSION_TTL_MS=300000
MAX_REPLAY_EVENTS=2000
# GATEWAY_PUBLIC_URL=wss://api.umaru.dev/api/v1/gateway/ws

# Mail xác thực email (0004_email_verification)
# Bỏ trống SMTP_URL = ghi mail ra log server (dev tự bấm link, không cần SMTP).
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Umaru <no-reply@umaru.local>"
# Gốc web app để dựng link trong mail. Production nên đặt tường minh.
PUBLIC_WEB_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SEC=60
# Trả token xác thực trong response (dev/test). BẬT Ở PRODUCTION = LỖ HỔNG:
# bất kỳ ai đăng ký cũng chiếm được tài khoản vừa tạo. Mặc định tắt khi NODE_ENV=production.
# EMAIL_VERIFICATION_ECHO=1
