# PostgreSQL (dev bằng Docker, xem README)
DATABASE_URL=postgres://umaru:umaru@127.0.0.1:55432/umaru
# BẮT BUỘC đổi khi NODE_ENV=production (server từ chối chạy với secret dev)
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu
PORT=4000
HOST=127.0.0.1
SNOWFLAKE_WORKER_ID=0

# Token
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# Tệp đính kèm (G1: lưu trên đĩa cục bộ; đổi sang R2/S3 thì chỉ thay lớp storage)
# UPLOADS_DIR=.data/uploads
MAX_UPLOAD_BYTES=10485760
# Avatar nằm trong <UPLOADS_DIR>/avatars; đổi AVATARS_DIR để tách hẳn (vd volume riêng).
# AVATARS_DIR=.data/uploads/avatars
MAX_AVATAR_BYTES=5242880

# Gateway (spec: docs/gateway-protocol.md)
HEARTBEAT_INTERVAL_MS=41250
SESSION_TTL_MS=300000
MAX_REPLAY_EVENTS=2000
# GATEWAY_PUBLIC_URL=wss://api.umaru.dev/api/v1/gateway/ws

# Mail xác thực email (0004_email_verification)
# Bỏ trống SMTP_URL = ghi mail ra log server (dev tự bấm link, không cần SMTP).
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Umaru <no-reply@umaru.local>"
# Gốc web app để dựng link trong mail. Production nên đặt tường minh.
PUBLIC_WEB_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SEC=60
# Trả token xác thực trong response (dev/test). BẬT Ở PRODUCTION = LỖ HỔNG:
# bất kỳ ai đăng ký cũng chiếm được tài khoản vừa tạo. Mặc định tắt khi NODE_ENV=production.
# EMAIL_VERIFICATION_ECHO=1

# Âm thanh kênh thoại (LiveKit Cloud). Cần ĐỦ CẢ BA; thiếu một cái là tắt âm
# thanh (trạng thái phòng vẫn chạy, GET /channels/:id/voice/token trả 503).
# LIVEKIT_API_SECRET chỉ nằm ở server — client chỉ nhận token đã ký, hạn 1 giờ,
# mở đúng một phòng. KHÔNG commit secret thật vào repo.
# LIVEKIT_URL=wss://ten-du-an.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LIVEKIT_TOKEN_TTL_SEC=3600

# Người vận hành xem hàng đợi báo cáo (GET /admin/reports, UI ở /admin/reports).
# Phân tách bằng dấu phẩy; username không phân biệt hoa/thường. Để trống = KHÔNG AI
# là admin (mặc định an toàn) và báo cáo vẫn được ghi nhưng không ai đọc được.
# ADMIN_USERNAMES=demo_user
# ADMIN_USER_IDS=240188945592221696
#
# Mail báo admin khi có báo cáo vi phạm mới. Bật mặc định; đặt off để tắt.
# Chỉ admin **thật sự được khai báo ở trên** mới nhận mail, không cấu hình admin
# thì không gửi cho ai. Nhiều báo cáo liên tiếp được gộp thành một mail trong
# khoảng giãn cách (giây) để không dội hộp thư người vận hành.
# REPORT_NOTIFY_EMAIL=off
# REPORT_NOTIFY_COOLDOWN_SEC=300

# ── Rate limit (spec §7) ────────────────────────────────────────────────────
# Bộ đếm token bucket trong bộ nhớ từng process. Đa node thì giới hạn thực tế
# nhân lên theo số node — chuyển sang Redis khi lên đa node.
# RATE_LIMITS=off                      # tắt hẳn (chỉ dùng cho test/bench)
# RATE_LIMIT_MESSAGES_PER_USER=5       # tin/5 giây/người/kênh
# RATE_LIMIT_MESSAGES_PER_CHANNEL=30   # tin/phút/kênh (chặn spam nhiều tài khoản)
# RATE_LIMIT_GATEWAY_FRAMES_PER_MINUTE=120
# RATE_LIMIT_SESSIONS_PER_USER=5       # vượt thì đóng session cũ nhất (4003)
# RATE_LIMIT_VOICE_MUTATIONS=10        # join/leave/mute kênh thoại mỗi 10 giây
