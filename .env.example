# Umaru — biến cho `docker compose`. Chép thành `.env` rồi điền.
#
#   cp .env.example .env
#
# `.env` đã nằm trong .gitignore. KHÔNG commit file đã điền giá trị thật.
#
# Hai biến dưới đây **bắt buộc**: compose sẽ dừng ngay nếu thiếu, thay vì chạy
# với cấu hình nửa vời (đây là chủ ý — xem DEPLOY.md).

# Mật khẩu Postgres. Sinh bằng: openssl rand -base64 24
POSTGRES_PASSWORD=

# Bí mật ký JWT (access + refresh). Sinh bằng: openssl rand -base64 48
# Đổi giá trị này là **mọi phiên đăng nhập bị đăng xuất** — đúng ý khi nghi lộ.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Cơ bản
# ---------------------------------------------------------------------------
POSTGRES_USER=umaru
POSTGRES_DB=umaru
# Cổng mở ra ngoài của nginx (SPA + /api). Sau đó đặt TLS ở Caddy/ALB phía trước.
WEB_PORT=8080

# URL công khai của app — dùng để dựng link trong mail xác thực.
PUBLIC_WEB_URL=http://localhost:8080
# URL WebSocket công khai. Để trống thì API tự suy ra từ request (có
# X-Forwarded-Proto/Host). Đặt tường minh khi chạy nhiều tầng proxy.
GATEWAY_PUBLIC_URL=

# Ai được xem hàng đợi báo cáo (phân tách bằng dấu phẩy). Để trống = không ai.
ADMIN_USERNAMES=
ADMIN_USER_IDS=

# ---------------------------------------------------------------------------
# Mail (xác thực email, báo cáo). Bỏ trống = ghi mail ra log (chỉ dùng khi dev).
# ---------------------------------------------------------------------------
SMTP_URL=
MAIL_FROM=Umaru <no-reply@umaru.local>

# ---------------------------------------------------------------------------
# Âm thanh + chia sẻ màn hình (LiveKit Cloud). Cần ĐỦ BA; thiếu là tắt hẳn.
# Lấy ở https://cloud.livekit.io → project → Settings → Keys.
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Thông báo đẩy khi đã đóng tab. Cần ĐỦ public + private.
# Sinh cặp khoá: node -e 'console.log(require("web-push").generateVAPIDKeys())'
# Đổi khoá là mọi subscription cũ phải đăng ký lại.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Nơi lưu tệp đính kèm + avatar
# ---------------------------------------------------------------------------
# Bỏ trống / `local` = ghi xuống volume `uploads` của container. Chỉ đúng khi
# chạy **một** node và chấp nhận mất tệp nếu volume bị xoá.
#
# `s3` = Cloudflare R2 / AWS S3 / MinIO / B2 — bắt buộc khi chạy nhiều node
# hoặc khi không muốn tệp phụ thuộc vòng đời container. Thiếu một biến trong
# bốn biến S3_* là API **dừng ngay lúc khởi động** (không lặng lẽ lùi về đĩa).
#
# R2: endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#     region  = auto
# MinIO: endpoint = http://minio:9000, region = us-east-1
STORAGE_DRIVER=local
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Tiền tố cho mọi khoá trong bucket. Đổi giá trị là "mất" tệp cũ (vẫn còn trong
# bucket nhưng app tìm ở chỗ khác) — đặt một lần rồi để yên.
S3_PREFIX=umaru

# ---------------------------------------------------------------------------
# Nhiều node gateway (tuỳ chọn)
# ---------------------------------------------------------------------------
# Bỏ trống = một node, fan-out trong bộ nhớ. Đặt REDIS_URL khi chạy ≥ 2 instance
# API: thiếu nó thì người ở node này **không nhận** tin của người ở node kia, và
# log không hề báo lỗi. Xem DEPLOY.md §9.
# Bật Redis đi kèm compose: đổi giá trị dưới thành redis://redis:6379/0 rồi chạy
#   docker compose --profile scale up -d --scale api=2
REDIS_URL=
REDIS_CHANNEL=umaru:gateway
# Mặc định `host:pid` — trong Docker đã khác nhau theo container. Đặt tay khi
# chạy nhiều tiến trình trên cùng một máy.
GATEWAY_NODE_ID=
